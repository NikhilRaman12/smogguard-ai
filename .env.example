# SmogGuard AI Configuration
# Copy to .env and fill in your keys

# Required - Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required for real-time AQI - Get free token from https://aqicn.org/data-platform/token/
# Use "demo" for testing (rate limited)
WAQI_API_TOKEN=demo

# Optional - Get from https://openweathermap.org/api (free tier)
OPENWEATHERMAP_API_KEY=

# Optional - Get from https://api.openaq.org/register
OPENAQ_API_KEY=

# Database (auto-configured for Docker)
DATABASE_URL=postgresql+asyncpg://smogguard:smogguard@db:5432/smogguard

# Redis (auto-configured for Docker)
REDIS_URL=redis://redis:6379/0

# JWT Secret (change in production!)
JWT_SECRET_KEY=smogguard-dev-secret-change-in-production-2024

# App Settings
APP_NAME=SmogGuard AI
DEBUG=true
